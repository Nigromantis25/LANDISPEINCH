# Copiar a .env y ajustar valores locales
# Opcional: URL de conexión directa a Postgres (ej: connection string de Supabase)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@...:6543/postgres

# Supabase (recomendado): URL y service_role key para el cliente del backend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

JWT_SECRET=tu_secret_key_openworld
PORT=3001
